{
  "expo": {
    "name": "AutoMatch",
    "slug": "automatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e81e40bf-bf54-4b2d-b252-deb795b2d787"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#06080B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.automatch.app"
    },
    "android": {
      "package": "com.automatch.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#06080B"
      },
      "permissions": ["RECEIVE_BOOT_COMPLETED", "VIBRATE"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-updates"
    ],
    "extra": {
      "eas": {
        "projectId": "e81e40bf-bf54-4b2d-b252-deb795b2d787"
      }
    },
    "owner": "itaytay40s-organization"
  }
}
