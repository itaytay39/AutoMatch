# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/caraggregator

# ── Redis (BullMQ queues) ───────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── Firebase FCM ────────────────────────────────────────────────
# Firebase Console → Project Settings → Service Accounts → Generate key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# ── yad2 scraping ───────────────────────────────────────────────
# Option A (recommended): Apify actor — get token at https://console.apify.com
APIFY_TOKEN=

# Option B: residential proxy for Playwright stealth
BRIGHTDATA_PROXY_URL=http://user:pass@proxy.brightdata.com:22225
# OR: PROXY_URL=http://user:pass@proxy.smartproxy.com:10000

# ── Admin API ───────────────────────────────────────────────────
# Header: x-admin-secret: <value>  →  POST /api/v1/admin/scrape
ADMIN_SECRET=automatch-dev

# ── Mobile app ──────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
